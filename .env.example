# ── Claude (conversation brain) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for the live conversation. claude-opus-5 default; effort "low" keeps
# voice latency down while adaptive thinking stays available for hard turns.
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2048

# ── Persona ──────────────────────────────────────────────────────────────────
BOT_NAME=Riley
CEO_NAME=Jane Smith
COMPANY_NAME=Acme Corp
# Optional: full custom greeting spoken when the call is answered.
# GREETING_TEXT=

# ── Scheduling ───────────────────────────────────────────────────────────────
TIMEZONE=America/New_York
BUSINESS_START=09:00
BUSINESS_END=17:00
# ISO weekdays that are bookable: 1=Mon ... 7=Sun
WORK_DAYS=1,2,3,4,5
MEETING_DURATION_MIN=30
BOOKING_WINDOW_DAYS=14
MIN_NOTICE_HOURS=2

# ── Calendar backend ─────────────────────────────────────────────────────────
# "memory" (dev/demo: everything inside business hours is free) or "google".
CALENDAR_PROVIDER=memory
# For google: create a service account, enable the Calendar API, share the
# CEO's calendar with the service account email ("Make changes to events").
# GOOGLE_CLIENT_EMAIL=svc@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_CALENDAR_ID=ceo@yourcompany.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# WebSocket path the jambonz application connects to (wss://host<path>).
JAMBONZ_WS_PATH=/assistant
# Shared secret required (as x-api-key header) on GET /context/:token —
# set the same value in the Genesys data action configuration.
# CONTEXT_API_KEY=change-me
# Where per-call JSONL transcripts are written.
CALL_LOG_DIR=call-logs

# ── Genesys hand-off ─────────────────────────────────────────────────────────
# SIP URI the bot bridges to when a human is needed: the escalation DID at
# your org's BYOC trunk FQDN (read the exact host from the trunk UI's
# "Inbound Request-URI Reference" panel). Use sips:/;transport=tls for TLS.
# GENESYS_TRANSFER_SIP_URI=sip:+15551230000@ceobot.byoc.usw2.pure.cloud
# Must match the trunk's UUI Protocol Discriminator setting (2 hex digits).
UUI_PROTOCOL_DISCRIMINATOR=00
